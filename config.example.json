{
  "target": {
    "tool_path": "/path/to/defects4j/framework/bin/defects4j",
    "workspace_root": "/path/to/your/workdir",
    "workspace_template": "{workspace_root}/d4j_{project}_{version}",
    "setup_cmd": "rm -rf {workspace} && {tool} checkout -p {project} -v {version} -w {workspace}",
    "test_cmd": "{tool} test -w {workspace}",
    "require_workspace": true,
    "source_glob": "*.java",
    "bug_id_pattern": "^(?P<project>[A-Za-z]+)_(?P<number>\\d+)(?P<suffix>[bf]?)$",
    "bug_id_template": "{project}_{version}",
    "default_version_suffix": "b",
    "passed_pattern": "Failing tests:\\s*0",
    "failed_pattern": "Failing tests:\\s*(?P<count>[1-9]\\d*)(?P<detail>[\\s\\S]*)",
    "patch_allow_globs": ["*/src/main/java/*", "*/src/java/*", "*/source/*"],
    "patch_deny_globs": ["*/src/test/*", "*/tests/*", "*/test/*"],
    "patch_must_be_under_workspace": true,
    "test_guard_enabled": true,
    "test_guard_globs": ["*/src/test/*", "*/tests/*", "*/test/*"],
    "test_guard_autorestore": true
  },
  "agent": {
    "max_attempts": 10,
    "max_turns": 100,
    "system_prompt_file": "AGENTS.md",
    "user_prompt_template": "Please fix the Defects4J bug {bug_id}. Begin by calling run_test with bug_id='{bug_id}'.",
    "fixed_marker": "[FIXED]",
    "failed_marker": "[FAILED]"
  },
  "timeouts": {
    "test_execution": 900,
    "llm_client": 960
  },
  "llm_config": {
    "api_key": "${DEEPSEEK_API_KEY}",
    "base_url": "https://api.deepseek.com/v1",
    "model_name": "deepseek-flash"
  },
  "benchmark_bugs": [
    "Lang_1",
    "Lang_4",
    "Lang_10",
    "Csv_1",
    "Codec_5",
    "Codec_11",
    "Cli_5",
    "Cli_13",

    "Lang_43",
    "Lang_51",
    "Lang_60",
    "Chart_1",
    "Chart_13",
    "Chart_26",
    "Time_4",
    "Time_11",
    "Time_19",
    "Csv_9",
    "Compress_7",
    "Compress_25",
    "Compress_38",
    "Cli_28",

    "Math_2",
    "Math_30",
    "Math_63",
    "Math_70",
    "Math_73",
    "Math_95",
    "Time_14",
    "Compress_45"
  ]
}
