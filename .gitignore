build/
dist/

# ZeroX specific
# logs/ is scratch space, except the audit trail we publish:
#   logs/benchmark_metrics.jsonl  one line per finished bug
#   logs/<bug>/human_audit.jsonl  discarded patches + rollback history
logs/**
!logs/**/
!logs/benchmark_metrics.jsonl
!logs/*/human_audit.jsonl
backups/
config.json
temp_code_*.txt
*.log

# Secrets
.env
.env.*

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db
