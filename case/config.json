{
  "target": {
    "tool_path": "javac",
    "workspace_root": "work",
    "workspace_template": "{workspace_root}/{bug_id}",
    "setup_cmd": "mkdir -p {workspace} && cp {workspace_root}/../pristine/{bug_id}.java {workspace}/{bug_id}.java",
    "test_cmd": "cd {workspace} && rm -rf /tmp/zerox_{bug_id} && mkdir -p /tmp/zerox_{bug_id} && {tool} -d /tmp/zerox_{bug_id} {bug_id}.java && java -cp /tmp/zerox_{bug_id} {bug_id}",
    "require_workspace": true,
    "source_glob": "*.java",
    "bug_id_pattern": "^(?P<bug_id>[A-Za-z0-9_]+)$",
    "bug_id_template": "{bug_id}",
    "default_version_suffix": "",
    "passed_pattern": "All tests passed",
    "failed_pattern": "(?P<detail>\\[FAIL\\][\\s\\S]*?)FAILED \\((?P<count>\\d+)\\)",
    "patch_allow_globs": [],
    "patch_deny_globs": [],
    "patch_must_be_under_workspace": true,
    "audit_test_globs": []
  },
  "agent": {
    "max_tests": 12,
    "compact_context_chars": 120000,
    "system_prompt_file": "AGENTS.md",
    "user_prompt_template": "Please fix the bug in {bug_id}. It is a single Java file that contains both the code under test and its tests: never change main(), the test helpers or the expected values. Begin by calling run_test with bug_id='{bug_id}'.",
    "fixed_marker": "[FIXED]",
    "failed_marker": "[FAILED]"
  },
  "timeouts": {
    "test_execution": 180,
    "llm_client": 300
  },
  "llm_config": {
    "api_key": "${DEEPSEEK_API_KEY}",
    "base_url": "https://api.deepseek.com/v1",
    "model_name": "deepseek-flash"
  },
  "benchmark_bugs": ["List_999"]
}
