# Python
__pycache__/
*.py[cod]
venv/
.venv/
env/
*.egg-info/
.pytest_cache/
build/
dist/

# ZeroX specific
# logs/ 整体为运行产物，不入库。benchmark_metrics.jsonl / audit.jsonl /
# <bug>/human_audit.jsonl 均为本机运行结果，结果以 README 表格为准；
# archive/ 为历史归档，同样不入库。
logs/**

# 仅忽略项目根目录的 config.json（本机配置）。
# 规则必须带前导斜杠：无斜杠的规则会在任意层级生效，从而误伤 case/config.json
/config.json
# 本机的一次性配置（单 bug 复测、换环境验证之类）——这些文件通常内嵌本机绝对路径 / API key。
# 模板除外：通过例外规则保留 config.example.json。
/config.*.json
!/config.example.json
# 带本地路径的私有配置：本地模型端点、个人环境参数等，由通用后缀 *.local.* 统一覆盖
# （如 config.local.json），避免本地配置随提交入库。
*.local.json
*.local.jsonl
*.local.toml
*.local.yaml
*.local.yml
*.local.txt
# 本地草稿区：调试实验、临时导出、抓包等本机产物统一放 local/；
# 该目录整体忽略，其下文件的入库状态由目录规则统一决定。
/local/
# 兜底规则：草稿区之外落下的调试文件同样忽略（常含本机绝对路径或调试输出）。
.tmp*/
/tmp/
/tools/tmp_*.sh
/tools/tmp_*.py
/temp_*
temp_code_*.txt
scratch_*.py
debug_*.py
# case/ 的工作区是生成物（由 setup_cmd 重建），基线位于 case/pristine/ 下，工作区不入库
case/work/
*.log

# Secrets
.env
.env.*

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db
